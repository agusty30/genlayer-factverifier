# GenLayer RPC API URL
# Default: https://rpc-bradbury.genlayer.com (Bradbury testnet, where FactVerifier is live)
# For local development, point this at your Studio node, e.g. http://localhost:4000/api
NEXT_PUBLIC_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# GenLayer Network Configuration (Bradbury testnet)
NEXT_PUBLIC_GENLAYER_CHAIN_ID=4221
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Bradbury Testnet
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-bradbury.genlayer.com

# FactVerifier contract address
# Defaults to the live Bradbury deployment if left unset.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0341797e201C1e697E89a199E6bC0e2e0bF5193a
