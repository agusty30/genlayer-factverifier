# GenLayer RPC API URL
# Default: https://studio-dev.genlayer.com/api (GenLayer Studio Dev, where FactVerifier is live)
# For local development, point this at your Studio node, e.g. http://localhost:4000/api
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api

# GenLayer Network Configuration (GenLayer Studio Dev)
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio Dev
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-studio-dev.genlayer.com

# FactVerifier contract address
# Defaults to the live Studio Dev deployment if left unset.
NEXT_PUBLIC_CONTRACT_ADDRESS=0xD0C23F62660e68fF2A6D70369aF33CDE5822fe11

# ── x402 pay-per-verdict API (server-only, never expose to the browser) ──
# The API submits claims to FactVerifier on GenLayer Studio Dev (chain 61997)
# from a demo wallet, paid $0.10 USDC on Base Sepolia via x402.
# DEMO_PRIVATE_KEY is REQUIRED for /api/verify to submit claims. Set it in
# Vercel (Project Settings > Environment Variables) or a local .env.local;
# NEVER commit it.
# DEMO_PRIVATE_KEY=0x...
GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
FACT_VERIFIER_ADDRESS=0xD0C23F62660e68fF2A6D70369aF33CDE5822fe11
# x402 payment recipient (demo wallet) and price; facilitator verifies + settles.
X402_PAY_TO=0x65cbf00EcD3D5c1091378A841f986997eFc42462
X402_PRICE=$0.10
X402_FACILITATOR_URL=https://x402.org/facilitator
